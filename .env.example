# Copy this file to .env and fill in real values before running any dkfr command
# that touches the network or Neo4j.

# Required — no default. Used to build an honest, descriptive User-Agent
# (spec R2.4). DBU blocks generic/anonymous crawler UAs (see robots.txt).
DBU_CONTACT_EMAIL=you@example.com

# Neo4j (local Docker via docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme12345
